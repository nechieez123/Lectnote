{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=lectnote;Username=lectnote;Password=change_me"
  },
  "Auth": {
    "SigningKey": "change-this-development-key-to-a-long-random-secret"
  },
  "Uploads": {
    "Path": "uploads",
    "MaxBytes": 104857600
  },
  "Transcription": {
    "DefaultLanguage": "pt"
  },
  "OpenAI": {
    "Model": "whisper-1",
    "BaseUrl": "https://api.openai.com/v1/audio/transcriptions"
  },
  "Cors": {
    "Origins": ["http://localhost:5173", "http://localhost:8080"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
