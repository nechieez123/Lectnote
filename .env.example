POSTGRES_DB=lectnote
POSTGRES_USER=lectnote
POSTGRES_PASSWORD=change_me
AUTH_SIGNING_KEY=change_this_to_a_long_random_secret
# Optional: enables real asynchronous audio transcription. Without it jobs fail safely, never with fabricated text.
OPENAI_API_KEY=<your Groq key>
OPENAI_MODEL=whisper-large-v3-turbo
OPENAI_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIPTION_DEFAULT_LANGUAGE=pt
UPLOADS_MAX_BYTES=104857600
