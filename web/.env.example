# Destino usado pelo proxy /api do Vite durante o desenvolvimento.
# Em StackBlitz, localhost é remoto; use um endpoint de desenvolvimento HTTPS autorizado.
API_PROXY_TARGET=http://localhost:5157
# Optional: set only when the API is hosted on a different origin from the frontend.
# Leave empty to use the same-origin /api path (Vite proxy in dev, Nginx proxy in Docker).
VITE_API_BASE_URL=
